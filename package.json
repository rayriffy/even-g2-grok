{
  "name": "even-g2-grok",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @rayriffy/g2-grokbot-glasses dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @rayriffy/g2-grokbot-glasses preview",
    "simulate": "pnpm --filter @rayriffy/g2-grokbot-glasses simulate",
    "capture:listing": "pnpm --filter @rayriffy/g2-grokbot-glasses capture:listing",
    "pack:demo": "pnpm --filter @rayriffy/g2-grokbot-glasses pack:demo",
    "pack:live": "pnpm --filter @rayriffy/g2-grokbot-glasses pack:live",
    "pack:gateway": "node -e \"require('node:fs').mkdirSync('artifacts', { recursive: true })\" && pnpm --dir packages/gateway pack --pack-destination ../../artifacts",
    "test": "pnpm -r test",
    "gateway": "pnpm --filter @rayriffy/g2-grokbot-gateway dev"
  }
}
