{
  "name": "@rayriffy/g2-grokbot-gateway",
  "version": "0.1.0",
  "description": "Elysia gateway for Grok Bot on Even G2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/index.js", "dist/index.d.ts", "dist/http.d.ts"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayriffy/even-g2-grok.git",
    "directory": "packages/gateway"
  },
  "scripts": {
    "build": "tsc --noEmit false --emitDeclarationOnly --declaration --outDir dist && bun build src/index.ts --target bun --external elysia --outfile dist/index.js",
    "dev": "bun src/serve.ts",
    "prepack": "pnpm build",
    "test": "node --test tests/*.test.ts"
  },
  "peerDependencies": { "elysia": "^1.4.28" },
  "devDependencies": {
    "@rayriffy/g2-grokbot-protocol": "workspace:*",
    "@types/bun": "1.4.5",
    "elysia": "1.4.32",
    "typescript": "7.0.2"
  }
}
